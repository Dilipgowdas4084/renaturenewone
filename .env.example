# Copy this template to .env or .env.local in the repository root.
# (Both .env and .env.local are supported; .env.local overrides .env in development)

# Server Port
PORT=3000

# Authentication Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database Configuration (Optional: built-in in-memory database is active by default)
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# Email / OTP Delivery (required for Forgot Password to work)
# Option A â€“ Gmail with an App Password (recommended for this project):
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Visit https://myaccount.google.com/apppasswords and create an app password.
#   3. Paste the 16-character app password (without spaces) into GMAIL_APP_PASSWORD.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B â€“ Generic SMTP (use instead of the Gmail variables above):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Google OAuth Configuration (Google Identity Services)
# Backend audience verification:
GOOGLE_CLIENT_ID=
# Frontend client ID (exposed to Vite browser client):
VITE_GOOGLE_CLIENT_ID=
